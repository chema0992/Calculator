<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>HYPER OVERKILL CALCULATOR 9000 MAX</title>
    <style>
        /* === 전역 설정 및 폰트 === */
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Black+Han+Sans&display=swap');

        :root {
            --glass-bg: rgba(15, 5, 30, 0.55);
            --glass-border: rgba(255, 255, 255, 0.25);
            --neon-1: #ff007f;
            --neon-2: #00f3ff;
            --neon-3: #ffe600;
            --neon-4: #00ff66;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #020208;
            font-family: 'Orbitron', sans-serif;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            perspective: 1000px;
            touch-action: manipulation;
        }

        /* === 오로라 배경 & 사이버 그리드 === */
        .aurora-bg {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg at 50% 50%, 
                #1a0033, #ff007f, #00f3ff, #00ff66, #ffe600, #ff0055, #1a0033);
            filter: blur(100px);
            animation: spinBg 12s linear infinite;
            z-index: -3;
            opacity: 0.7;
            pointer-events: none;
        }

        .cyber-grid {
            position: absolute;
            width: 200%;
            height: 200%;
            top: -50%;
            left: -50%;
            background-image: 
                linear-gradient(to right, rgba(0, 243, 255, 0.1) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 0, 127, 0.1) 1px, transparent 1px);
            background-size: 50px 50px;
            transform: rotateX(60deg);
            animation: gridMove 10s linear infinite;
            z-index: -2;
            pointer-events: none;
        }

        @keyframes spinBg {
            100% { transform: rotate(360deg); }
        }

        @keyframes gridMove {
            0% { transform: rotateX(60deg) translateY(0); }
            100% { transform: rotateX(60deg) translateY(50px); }
        }

        /* Scanline CRT 필터 */
        .crt-overlay {
            position: absolute;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
            background-size: 100% 4px;
            z-index: 100;
            pointer-events: none;
            opacity: 0.6;
        }

        /* FX 캔버스 */
        #fx-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            pointer-events: none;
        }

        /* 번쩍임 오버레이 */
        #flash-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle, #ffffff, #ff00ff, #00ffff);
            z-index: 999;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.08s ease-out;
            mix-blend-mode: overlay;
        }

        /* === 콤보 배지 === */
        .combo-container {
            position: absolute;
            top: -45px;
            right: 10px;
            display: flex;
            align-items: center;
            gap: 5px;
            opacity: 0;
            transform: scale(0.5) rotate(-10deg);
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            pointer-events: none;
            z-index: 20;
        }

        .combo-container.active {
            opacity: 1;
            transform: scale(1.1) rotate(-5deg);
        }

        .combo-text {
            font-family: 'Black Han Sans', sans-serif;
            font-size: 1.8rem;
            background: linear-gradient(135deg, #ffe600, #ff007f);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 0 15px rgba(255, 230, 0, 0.8);
            animation: pulseCombo 0.3s infinite alternate;
        }

        @keyframes pulseCombo {
            0% { transform: scale(1); }
            100% { transform: scale(1.15) rotate(3deg); }
        }

        /* === 메인 계산기 프레임 === */
        .calculator-wrapper {
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.15s cubic-bezier(0.2, 0, 0.2, 1);
            will-change: transform;
        }

        .calculator {
            position: relative;
            background: var(--glass-bg);
            backdrop-filter: blur(30px) saturate(220%);
            -webkit-backdrop-filter: blur(30px) saturate(220%);
            border: 2px solid var(--glass-border);
            border-radius: 35px;
            padding: 30px;
            width: 400px;
            box-shadow: 
                0 0 40px var(--neon-1),
                inset 0 0 30px var(--neon-2),
                0 30px 80px rgba(0,0,0,0.9);
            animation: floatCalc 6s ease-in-out infinite, neonPulseCalc 2.5s infinite alternate;
            z-index: 10;
        }

        /* RGB 회전 테두리 마스크 */
        .calculator::before {
            content: '';
            position: absolute;
            top: -4px; left: -4px; right: -4px; bottom: -4px;
            background: linear-gradient(45deg, #ff0000, #ff7f00, #ffff00, #00ff00, #00ffff, #0000ff, #8b00ff, #ff0000);
            background-size: 400%;
            border-radius: 38px;
            z-index: -1;
            animation: rgbBorder 8s linear infinite;
            opacity: 0.8;
            filter: blur(8px);
            pointer-events: none;
        }

        @keyframes rgbBorder {
            0% { background-position: 0% 0%; }
            100% { background-position: 400% 0%; }
        }

        .shake-active {
            animation: hyperShake 0.35s cubic-bezier(.36,.07,.19,.97) both !important;
        }

        @keyframes floatCalc {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        @keyframes hyperShake {
            10%, 90% { transform: translate3d(-4px, 3px, 0); }
            20%, 80% { transform: translate3d(5px, -4px, 0); }
            30%, 50%, 70% { transform: translate3d(-6px, 5px, 0); }
            40%, 60% { transform: translate3d(6px, -5px, 0); }
        }

        @keyframes neonPulseCalc {
            0% { box-shadow: 0 0 30px var(--neon-1), inset 0 0 20px var(--neon-2); }
            50% { box-shadow: 0 0 60px var(--neon-2), inset 0 0 40px var(--neon-3); }
            100% { box-shadow: 0 0 40px var(--neon-3), inset 0 0 25px var(--neon-4); }
        }

        /* === 디스플레이 === */
        .display-container {
            background: rgba(3, 3, 12, 0.8);
            border-radius: 22px;
            padding: 22px;
            margin-bottom: 25px;
            box-shadow: inset 0 0 25px rgba(0,0,0,1), 0 0 15px rgba(0,243,255,0.3);
            text-align: right;
            border: 1px solid rgba(255,255,255,0.15);
            position: relative;
            overflow: hidden;
            pointer-events: none;
        }

        .display-container::after {
            content: '';
            position: absolute;
            top: 0; left: -100%; width: 60%; height: 100%;
            background: linear-gradient(to right, transparent, rgba(255,255,255,0.25), transparent);
            transform: skewX(-30deg);
            animation: glassShine 3s infinite;
            pointer-events: none;
        }

        @keyframes glassShine {
            0% { left: -100%; }
            30%, 100% { left: 220%; }
        }

        .history {
            font-size: 1.2rem;
            color: rgba(255,255,255,0.6);
            min-height: 1.6rem;
            margin-bottom: 5px;
            text-shadow: 0 0 8px rgba(0, 243, 255, 0.6);
            transition: all 0.2s;
            letter-spacing: 1px;
        }

        .current-num {
            font-size: 3.6rem;
            font-weight: 900;
            color: transparent;
            background-image: linear-gradient(90deg, #ff007f, #00f3ff, #ffe600, #00ff66, #ff007f);
            background-size: 300% auto;
            -webkit-background-clip: text;
            background-clip: text;
            animation: rainbowText 2.5s linear infinite, popIn 0.12s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            text-shadow: 0 0 25px rgba(255,255,255,0.3);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @keyframes rainbowText {
            to { background-position: 300% center; }
        }
        @keyframes popIn {
            0% { transform: scale(0.7) translateY(15px); opacity: 0; }
            100% { transform: scale(1) translateY(0); opacity: 1; }
        }

        /* === 키패드 === */
        .keypad {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .btn {
            position: relative;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-bottom: 5px solid rgba(255, 255, 255, 0.2);
            border-radius: 18px;
            color: white;
            font-size: 1.9rem;
            font-family: inherit;
            font-weight: 700;
            cursor: pointer;
            height: 72px;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: background 0.1s, box-shadow 0.1s, transform 0.05s;
            box-shadow: 0 8px 20px rgba(0,0,0,0.6);
            overflow: hidden;
            z-index: 1;
            touch-action: manipulation;
        }

        .btn .ripple {
            position: absolute;
            border-radius: 50%;
            transform: scale(0);
            animation: rippleAnim 0.4s linear;
            background: radial-gradient(circle, rgba(255,255,255,0.8), rgba(0,243,255,0.4));
            pointer-events: none;
            z-index: 0;
        }

        @keyframes rippleAnim {
            to { transform: scale(4.5); opacity: 0; }
        }

        .btn-content {
            z-index: 2;
            pointer-events: none;
            transition: transform 0.1s;
        }

        .btn:hover {
            background: rgba(255, 255, 255, 0.2);
            box-shadow: 0 0 25px rgba(0, 243, 255, 0.6), inset 0 0 15px rgba(255, 255, 255, 0.3);
        }

        .btn:hover .btn-content {
            transform: scale(1.1);
        }

        .btn:active, .btn.pressed {
            transform: translateY(4px);
            border-bottom-width: 1px;
            box-shadow: 0 0 20px var(--neon-1);
        }

        /* 버튼 타입별 특수 색상 */
        .btn.op { color: var(--neon-2); text-shadow: 0 0 12px var(--neon-2); border-color: rgba(0, 243, 255, 0.4); }
        .btn.ac { color: #ff0055; text-shadow: 0 0 12px #ff0055; border-color: rgba(255, 0, 85, 0.4); }
        .btn.eq { 
            grid-column: span 2; 
            background: linear-gradient(135deg, #ff007f, #7928ca, #00f3ff); 
            background-size: 200% 200%;
            border-bottom-color: #4a00e0;
            box-shadow: 0 10px 25px rgba(255,0,127,0.6);
            animation: pulseBtn 1.8s infinite alternate, eqGradient 4s ease infinite;
        }
        
        @keyframes eqGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .btn.eq:hover { box-shadow: 0 0 40px #ff007f, 0 0 20px #00f3ff; }

        @keyframes pulseBtn {
            0% { filter: brightness(1) drop-shadow(0 0 5px var(--neon-1)); }
            100% { filter: brightness(1.3) drop-shadow(0 0 15px var(--neon-2)); }
        }
        
        /* 플로팅 빛 구체 */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(15px);
            z-index: 5;
            animation: floatOrb 5s infinite ease-in-out alternate;
            pointer-events: none;
        }
        .orb1 { width: 60px; height: 60px; background: #00f3ff; top: -20px; left: -20px; animation-delay: 0s; }
        .orb2 { width: 80px; height: 80px; background: #ff007f; bottom: -30px; right: -30px; animation-delay: -2.5s; }
        
        @keyframes floatOrb {
            0% { transform: translateY(0) scale(1); opacity: 0.6; }
            100% { transform: translateY(-35px) scale(1.4); opacity: 0.9; }
        }

    </style>
</head>
<body>

    <!-- CRT 스캔라인 효과 -->
    <div class="crt-overlay"></div>
    <!-- 오로라 배경 -->
    <div class="aurora-bg"></div>
    <!-- 사이버 3D 그리드 -->
    <div class="cyber-grid"></div>
    <!-- 파티클 & 이펙트 캔버스 -->
    <canvas id="fx-canvas"></canvas>
    <!-- 화면 Flash 오버레이 -->
    <div id="flash-overlay"></div>

    <!-- 계산기 메인 래퍼 -->
    <div class="calculator-wrapper" id="calc-wrapper">
        <main class="calculator" id="calc-body">
            <!-- 콤보 표시기 -->
            <div class="combo-container" id="combo-badge">
                <span class="combo-text" id="combo-count">HYPER x2</span>
            </div>

            <div class="orb orb1"></div>
            <div class="orb orb2"></div>

            <div class="display-container">
                <div class="history" id="history"></div>
                <div class="current-num" id="current">0</div>
            </div>

            <div class="keypad" id="keypad">
                <button class="btn ac" data-type="clear"><span class="btn-content">AC</span></button>
                <button class="btn op" data-type="op" data-val="("><span class="btn-content">(</span></button>
                <button class="btn op" data-type="op" data-val=")"><span class="btn-content">)</span></button>
                <button class="btn op" data-type="op" data-val="/"><span class="btn-content">÷</span></button>
                
                <button class="btn num" data-type="num" data-val="7"><span class="btn-content">7</span></button>
                <button class="btn num" data-type="num" data-val="8"><span class="btn-content">8</span></button>
                <button class="btn num" data-type="num" data-val="9"><span class="btn-content">9</span></button>
                <button class="btn op" data-type="op" data-val="*"><span class="btn-content">×</span></button>
                
                <button class="btn num" data-type="num" data-val="4"><span class="btn-content">4</span></button>
                <button class="btn num" data-type="num" data-val="5"><span class="btn-content">5</span></button>
                <button class="btn num" data-type="num" data-val="6"><span class="btn-content">6</span></button>
                <button class="btn op" data-type="op" data-val="-"><span class="btn-content">-</span></button>
                
                <button class="btn num" data-type="num" data-val="1"><span class="btn-content">1</span></button>
                <button class="btn num" data-type="num" data-val="2"><span class="btn-content">2</span></button>
                <button class="btn num" data-type="num" data-val="3"><span class="btn-content">3</span></button>
                <button class="btn op" data-type="op" data-val="+"><span class="btn-content">+</span></button>
                
                <button class="btn num" data-type="num" data-val="0"><span class="btn-content">0</span></button>
                <button class="btn num" data-type="num" data-val="."><span class="btn-content">.</span></button>
                <button class="btn eq" data-type="eq"><span class="btn-content">=</span></button>
            </div>
        </main>
    </div>

    <script>
        /* =======================================================================
           1. Web Audio API 신시사이저 (콤보 피치 업 + 서브 베이스)
        ======================================================================== */
        let audioCtx = null;
        function initAudio() {
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') audioCtx.resume();
            } catch (e) {
                console.warn("오디오 초기화 실패:", e);
            }
        }

        function playSound(type, comboMultiplier = 1) {
            initAudio();
            if (!audioCtx) return;

            try {
                const now = audioCtx.currentTime;
                const pitchShift = Math.min((comboMultiplier - 1) * 40, 300);

                if (type === 'num' || type === 'op') {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);

                    osc.type = type === 'num' ? 'sine' : 'triangle';
                    const baseFreq = type === 'num' ? 600 : 400;
                    osc.frequency.setValueAtTime(baseFreq + pitchShift + Math.random()*50, now);
                    
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
                    
                    osc.start(now);
                    osc.stop(now + 0.1);
                } else if (type === 'eq') {
                    // 서브 베이스
                    const bassOsc = audioCtx.createOscillator();
                    const bassGain = audioCtx.createGain();
                    bassOsc.connect(bassGain);
                    bassGain.connect(audioCtx.destination);

                    bassOsc.type = 'sawtooth';
                    bassOsc.frequency.setValueAtTime(140, now);
                    bassOsc.frequency.exponentialRampToValueAtTime(30, now + 0.4);

                    bassGain.gain.setValueAtTime(0.4, now);
                    bassGain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

                    bassOsc.start(now);
                    bassOsc.stop(now + 0.4);

                    // 코드음
                    [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
                        const synthOsc = audioCtx.createOscillator();
                        const synthGain = audioCtx.createGain();
                        synthOsc.connect(synthGain);
                        synthGain.connect(audioCtx.destination);

                        synthOsc.type = 'triangle';
                        synthOsc.frequency.setValueAtTime(freq, now + idx * 0.04);

                        synthGain.gain.setValueAtTime(0.15, now + idx * 0.04);
                        synthGain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);

                        synthOsc.start(now + idx * 0.04);
                        synthOsc.stop(now + 0.5);
                    });
                } else if (type === 'ac') {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);

                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(350, now);
                    osc.frequency.linearRampToValueAtTime(80, now + 0.2);

                    gain.gain.setValueAtTime(0.25, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);

                    osc.start(now);
                    osc.stop(now + 0.2);
                }
            } catch (e) {
                // 오디오 재생 실패 무시
            }
        }

        /* =======================================================================
           2. 캔버스 파티클 시스템 (별, 마우스 트레일, 충격파, 수학기호 파티클)
        ======================================================================== */
        const canvas = document.getElementById('fx-canvas');
        const ctx = canvas.getContext('2d');
        let width, height;
        let particles = [];
        let shockwaves = [];
        let stars = [];
        let mathSymbols = ['+', '-', '×', '÷', '=', '√', '∞', '%', 'π', '7', '8', '9'];

        function resizeCanvas() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        for(let i=0; i<250; i++) {
            stars.push({
                x: Math.random() * width,
                y: Math.random() * height,
                radius: Math.random() * 1.5 + 0.5,
                vx: (Math.random() - 0.5) * 0.5,
                vy: (Math.random() - 0.5) * 0.5,
                alpha: Math.random(),
                color: `hsl(${Math.random() * 360}, 100%, 75%)`
            });
        }

        function createShockwave(x, y, color = '#00f3ff') {
            shockwaves.push({
                x: x,
                y: y,
                radius: 10,
                maxRadius: 150 + Math.random() * 80,
                color: color,
                alpha: 1,
                lineWidth: 6
            });
        }

        function createParticles(x, y, count, type='spark') {
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = type === 'confetti' ? Math.random() * 16 + 5 : Math.random() * 7 + 2;
                particles.push({
                    x: x,
                    y: y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed + (type === 'confetti' ? -7 : 0),
                    radius: type === 'confetti' ? Math.random() * 7 + 3 : Math.random() * 3 + 1.5,
                    color: `hsl(${Math.random() * 360}, 100%, 60%)`,
                    alpha: 1,
                    decay: type === 'confetti' ? 0.01 : (Math.random() * 0.03 + 0.02),
                    type: type,
                    symbol: mathSymbols[Math.floor(Math.random() * mathSymbols.length)],
                    fontSize: Math.floor(Math.random() * 14 + 12),
                    angle: Math.random() * 360,
                    spin: (Math.random() - 0.5) * 10
                });
            }
        }

        window.addEventListener('mousemove', (e) => {
            if (Math.random() > 0.3) {
                createParticles(e.clientX, e.clientY, 1, 'trail');
            }
        });

        function animateCanvas() {
            ctx.fillStyle = 'rgba(2, 2, 8, 0.25)';
            ctx.fillRect(0, 0, width, height);

            stars.forEach(star => {
                star.x += star.vx;
                star.y += star.vy;
                if(star.x < 0) star.x = width;
                if(star.x > width) star.x = 0;
                if(star.y < 0) star.y = height;
                if(star.y > height) star.y = 0;
                
                star.alpha += (Math.random() - 0.5) * 0.08;
                if(star.alpha < 0.2) star.alpha = 0.2;
                if(star.alpha > 1) star.alpha = 1;

                ctx.beginPath();
                ctx.arc(star.x, star.y, star.radius, 0, Math.PI*2);
                ctx.fillStyle = star.color;
                ctx.globalAlpha = star.alpha;
                ctx.fill();
            });

            for (let i = shockwaves.length - 1; i >= 0; i--) {
                let sw = shockwaves[i];
                sw.radius += (sw.maxRadius - sw.radius) * 0.18;
                sw.alpha -= 0.035;
                sw.lineWidth *= 0.94;

                ctx.save();
                ctx.beginPath();
                ctx.arc(sw.x, sw.y, sw.radius, 0, Math.PI * 2);
                ctx.strokeStyle = sw.color;
                ctx.lineWidth = sw.lineWidth;
                ctx.globalAlpha = Math.max(0, sw.alpha);
                ctx.shadowBlur = 15;
                ctx.shadowColor = sw.color;
                ctx.stroke();
                ctx.restore();

                if (sw.alpha <= 0) {
                    shockwaves.splice(i, 1);
                }
            }

            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.alpha -= p.decay;

                ctx.save();
                ctx.globalAlpha = Math.max(0, p.alpha);

                if (p.type === 'symbol') {
                    p.angle += p.spin;
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.angle * Math.PI / 180);
                    ctx.font = `bold ${p.fontSize}px Orbitron, sans-serif`;
                    ctx.fillStyle = p.color;
                    ctx.shadowBlur = 10;
                    ctx.shadowColor = p.color;
                    ctx.fillText(p.symbol, 0, 0);
                } else if (p.type === 'confetti') {
                    p.vy += 0.3;
                    p.angle += p.spin;
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.angle * Math.PI / 180);
                    ctx.fillStyle = p.color;
                    ctx.shadowBlur = 8;
                    ctx.shadowColor = p.color;
                    ctx.fillRect(-p.radius/2, -p.radius/2, p.radius, p.radius*1.4);
                } else {
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = p.color;
                    ctx.shadowBlur = 8;
                    ctx.shadowColor = p.color;
                    ctx.fill();
                }

                ctx.restore();

                if (p.alpha <= 0) {
                    particles.splice(i, 1);
                }
            }

            requestAnimationFrame(animateCanvas);
        }
        animateCanvas();

        /* =======================================================================
           3. 3D 패럴랙스 틸트 (안정화 적용) & 콤보 시스템
        ======================================================================== */
        const calcWrapper = document.getElementById('calc-wrapper');
        const calcBody = document.getElementById('calc-body');
        const comboBadge = document.getElementById('combo-badge');
        const comboCountText = document.getElementById('combo-count');

        let comboCount = 0;
        let comboTimer = null;

        // 마우스 이동 시 부드럽고 가벼운 3D 기울임 (버튼 클릭 타겟 유지)
        window.addEventListener('mousemove', (e) => {
            const cx = window.innerWidth / 2;
            const cy = window.innerHeight / 2;
            const rotX = ((e.clientY - cy) / cy) * -6; 
            const rotY = ((e.clientX - cx) / cx) * 6;

            calcWrapper.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
        });

        function registerCombo() {
            comboCount++;
            comboCountText.innerText = `HYPER x${comboCount}`;
            comboBadge.classList.add('active');

            comboBadge.style.animation = 'none';
            comboBadge.offsetHeight;
            comboBadge.style.animation = 'pulseCombo 0.2s ease-out';

            clearTimeout(comboTimer);
            comboTimer = setTimeout(() => {
                comboCount = 0;
                comboBadge.classList.remove('active');
            }, 1200);
        }

        /* =======================================================================
           4. 계산기 입력 로직 & 고성능 pointerdown 이벤트 핸들링
        ======================================================================== */
        const displayCurrent = document.getElementById('current');
        const displayHistory = document.getElementById('history');
        const flashOverlay = document.getElementById('flash-overlay');
        let expression = '';
        let isEvaluated = false;

        function updateDisplay(val) {
            displayCurrent.innerText = val || '0';
            displayCurrent.style.animation = 'none';
            displayCurrent.offsetHeight;
            displayCurrent.style.animation = 'rainbowText 2.5s linear infinite, popIn 0.12s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        }

        function handleInput(val, type, clickPos = null) {
            registerCombo();

            if (type === 'clear') {
                expression = '';
                updateDisplay('0');
                displayHistory.innerText = '';
                playSound('ac', comboCount);
                if (clickPos) createShockwave(clickPos.x, clickPos.y, '#ff0055');
                return;
            }

            if (type === 'eq') {
                if (!expression) return;
                try {
                    let sanitized = expression.replace(/[^-()\d/*+.]/g, '');
                    let result = new Function('return ' + sanitized)();
                    
                    if(result % 1 !== 0) result = parseFloat(result.toFixed(6));
                    
                    displayHistory.innerText = expression + ' =';
                    expression = result.toString();
                    updateDisplay(expression);
                    isEvaluated = true;
                    
                    playSound('eq', comboCount);
                    calcBody.classList.add('shake-active');
                    setTimeout(() => calcBody.classList.remove('shake-active'), 350);
                    
                    flashOverlay.style.opacity = '0.7';
                    setTimeout(() => flashOverlay.style.opacity = '0', 100);

                    const explosionX = clickPos ? clickPos.x : width / 2;
                    const explosionY = clickPos ? clickPos.y : height / 2;
                    
                    createShockwave(explosionX, explosionY, '#ffe600');
                    createShockwave(explosionX, explosionY, '#ff007f');
                    createParticles(explosionX, explosionY, 35 + comboCount * 8, 'confetti');
                    createParticles(explosionX, explosionY, 20, 'symbol');

                } catch (e) {
                    updateDisplay('ERROR');
                    expression = '';
                    playSound('ac', comboCount);
                }
                return;
            }

            playSound(type, comboCount);
            if (clickPos) {
                createShockwave(clickPos.x, clickPos.y, type === 'op' ? '#00f3ff' : '#ffffff');
                createParticles(clickPos.x, clickPos.y, 6, 'symbol');
            }

            if (isEvaluated && type === 'num') {
                expression = val;
                isEvaluated = false;
            } else if (isEvaluated && type === 'op') {
                expression += val;
                isEvaluated = false;
            } else {
                if(expression === '0' && type === 'num') expression = val;
                else expression += val;
            }
            
            displayHistory.innerText = expression;
            let currentView = expression.match(/[\d.]+$/);
            updateDisplay(currentView ? currentView[0] : val);
        }

        // 버튼 눌림 처리 (pointerdown으로 씹힘 완벽 방지)
        document.querySelectorAll('.btn').forEach(btn => {
            const onTrigger = (e) => {
                if (e.cancelable) e.preventDefault();

                const rect = btn.getBoundingClientRect();
                const clientX = e.clientX || (e.touches && e.touches[0] ? e.touches[0].clientX : rect.left + rect.width/2);
                const clientY = e.clientY || (e.touches && e.touches[0] ? e.touches[0].clientY : rect.top + rect.height/2);

                const x = clientX - rect.left;
                const y = clientY - rect.top;
                
                // 물결 생성
                const ripple = document.createElement('span');
                ripple.classList.add('ripple');
                ripple.style.left = `${x}px`;
                ripple.style.top = `${y}px`;
                
                const size = Math.max(rect.width, rect.height) * 2.2;
                ripple.style.width = ripple.style.height = `${size}px`;
                ripple.style.marginLeft = ripple.style.marginTop = `${-size/2}px`;
                
                btn.appendChild(ripple);
                setTimeout(() => ripple.remove(), 400);

                // 눌림 시각 효과
                btn.classList.add('pressed');
                setTimeout(() => btn.classList.remove('pressed'), 120);

                const val = btn.getAttribute('data-val');
                const type = btn.getAttribute('data-type');
                handleInput(val, type, { x: clientX, y: clientY });
            };

            btn.addEventListener('pointerdown', onTrigger);
        });

        // 키보드 지원
        document.addEventListener('keydown', (e) => {
            const key = e.key;
            let targetBtn = null;

            if (/[0-9.]/.test(key)) {
                targetBtn = document.querySelector(`.btn[data-val="${key}"]`);
            } else if (['+', '-', '*', '/', '(', ')'].includes(key)) {
                targetBtn = document.querySelector(`.btn[data-val="${key}"]`);
            } else if (key === 'Enter' || key === '=') {
                targetBtn = document.querySelector('.btn.eq');
            } else if (key === 'Escape' || key === 'Backspace') {
                targetBtn = document.querySelector('.btn.ac');
            }

            if (targetBtn) {
                e.preventDefault();
                
                targetBtn.classList.add('pressed');
                setTimeout(() => targetBtn.classList.remove('pressed'), 120);

                const rect = targetBtn.getBoundingClientRect();
                const clickPos = { x: rect.left + rect.width/2, y: rect.top + rect.height/2 };

                const val = targetBtn.getAttribute('data-val');
                const type = targetBtn.getAttribute('data-type');
                handleInput(val, type, clickPos);
            }
        });

    </script>
</body>
</html>
